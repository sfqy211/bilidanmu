---
import Layout from '~/layouts/PageLayout.astro';
import '~/assets/styles/landing.css';

import Hero from '~/components/landing/Hero.astro';
import Marquee from '~/components/landing/Marquee.astro';
import Bento from '~/components/landing/Bento.astro';
import FilmSection from '~/components/landing/FilmSection.astro';
import Scenes from '~/components/landing/Scenes.astro';
import Faq from '~/components/landing/Faq.astro';
import Download from '~/components/landing/Download.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const metadata = {
  title: 'BiliDanmu — 桌面弹幕伴侣',
  description:
    '把 B 站直播弹幕与视频装进桌面：透明弹幕窗、贴边收起、直播互动、听视频与本地字幕。免费、开源、本地运行。',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <div class="lp">
    <Hero />
    <div class="lp-feature-flow">
      <Marquee />
      <Bento />
    </div>
    <FilmSection />
    <Scenes />
    <Faq />
    <Download />

    <dialog id="film-dialog" class="lp-dialog" aria-label="BiliDanmu 产品演示">
      <div class="lp-dialog-stage">
        <video
          src={`${base}marketing/product-film.mp4`}
          poster={`${base}marketing/film-poster.webp`}
          controls
          playsinline
          preload="none"
        >
          你的浏览器不支持视频播放，可以
          <a href={`${base}marketing/product-film.mp4`}>直接下载演示视频</a>。
        </video>
        <button type="button" data-close-film class="lp-dialog-close">
          关闭 <kbd class="ml-1 text-[10px] opacity-70">Esc</kbd>
        </button>
      </div>
    </dialog>
  </div>

  <script>
    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const dialog = document.querySelector<HTMLDialogElement>('#film-dialog');
      if (!dialog) return;
      if (event.target.closest('[data-open-film]')) {
        dialog.showModal();
        dialog
          .querySelector('video')
          ?.play()
          .catch(() => {});
      } else if (event.target === dialog || event.target.closest('[data-close-film]')) {
        dialog.close();
      }
    });

    document.addEventListener(
      'close',
      (event) => {
        if (!(event.target instanceof HTMLDialogElement) || event.target.id !== 'film-dialog') return;
        const video = event.target.querySelector('video');
        if (!video) return;
        video.pause();
        if (video.readyState > 0) video.currentTime = 0;
      },
      true
    );
  </script>
</Layout>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    .lp [data-reveal][data-animated='true'] {
      animation: lp-reveal 520ms var(--lp-motion-ease) backwards;
    }

    .lp [data-reveal='hero'][data-animated='true'] {
      animation-duration: 640ms;
    }

    .lp .lp-faq-item[open] .lp-faq-answer {
      animation: lp-reveal 260ms var(--lp-motion-ease) backwards;
    }
  }

  @keyframes lp-reveal {
    from {
      opacity: 0.45;
      translate: 0 14px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
</style>
