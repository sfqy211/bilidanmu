---
import Layout from '~/layouts/PageLayout.astro';
import '~/assets/styles/landing.css';

import Hero from '~/components/landing/Hero.astro';
import Marquee from '~/components/landing/Marquee.astro';
import Bento from '~/components/landing/Bento.astro';
import FilmSection from '~/components/landing/FilmSection.astro';
import Scenes from '~/components/landing/Scenes.astro';
import Faq from '~/components/landing/Faq.astro';
import Download from '~/components/landing/Download.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const metadata = {
  title: 'BiliDanmu — 桌面弹幕伴侣',
  description:
    '把 B 站直播弹幕与视频装进桌面：透明弹幕窗、贴边收起、直播互动、听视频与本地字幕。免费、开源、本地运行。',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <div class="lp">
    <Hero />
    <Marquee />
    <Bento />
    <FilmSection />
    <Scenes />
    <Faq />
    <Download />
  </div>

  <dialog id="film-dialog" class="lp-dialog" aria-label="BiliDanmu 产品演示">
    <div class="relative">
      <video
        src={`${base}marketing/product-film.mp4`}
        poster={`${base}marketing/film-poster.webp`}
        controls
        playsinline
        preload="none"
      >
        你的浏览器不支持视频播放，可以
        <a href={`${base}marketing/product-film.mp4`}>直接下载演示视频</a>。
      </video>
      <button
        type="button"
        data-close-film
        class="absolute right-3 top-3 inline-flex items-center gap-1.5 rounded-full border border-white/15 bg-black/55 px-3 py-1.5 text-xs font-medium text-white/85 backdrop-blur transition hover:bg-black/75"
      >
        关闭
        <kbd class="rounded bg-white/15 px-1.5 py-0.5 text-[10px] text-white/60">Esc</kbd>
      </button>
    </div>
  </dialog>

  <script>
    const dialog = document.getElementById('film-dialog') as HTMLDialogElement | null;
    const video = dialog?.querySelector('video') as HTMLVideoElement | null;

    document.querySelectorAll('[data-open-film]').forEach((button) => {
      button.addEventListener('click', () => {
        if (!dialog) return;
        dialog.showModal();
        if (video) video.play().catch(() => {});
      });
    });

    document.querySelectorAll('[data-close-film]').forEach((button) => {
      button.addEventListener('click', () => dialog?.close());
    });

    if (dialog) {
      dialog.addEventListener('close', () => {
        if (!video) return;
        video.pause();
        video.currentTime = 0;
      });
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    }
  </script>
</Layout>
