---
import { Icon } from 'astro-icon/components';
import cover0 from '~/assets/images/bilidanmu/cover-0.svg';
import ProductPreview from './ProductPreview.astro';
---

<section id="features" class="scroll-mt-24 pb-16 pt-12 sm:pb-24 sm:pt-16">
  <div class="relative mx-auto max-w-7xl px-5 sm:px-8">
    <div class="intersect intersect-once flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between" data-reveal>
      <div>
        <p class="lp-eyebrow">核心功能</p>
        <h2 class="lp-h2 mt-3">少即是多。</h2>
      </div>
      <p class="lp-lead max-w-sm sm:text-right">需要时它在，不需要时退到屏幕边缘。</p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-12">
      <!-- 直播互动 -->
      <article
        class="lp-bento-card is-dark intersect intersect-once flex flex-col justify-between p-5 sm:p-6 md:col-span-7"
        data-reveal
      >
        <div>
          <div class="lp-panel-accent flex items-center gap-2 text-[11px] font-semibold tracking-[0.14em]">
            <Icon name="tabler:message-circle" class="h-4 w-4" /> 直播互动
          </div>
          <h3 class="lp-card-title mt-2">礼物、SC、上舰</h3>
        </div>

        <div class="bento-live-activity bento-image-frame mt-6">
          <ProductPreview kind="live" alt="直播弹幕窗口内的礼物、上舰、醒目留言开关和互动消息" />
        </div>
      </article>

      <!-- 贴边收起 -->
      <article
        class="lp-bento-card intersect intersect-once flex flex-col justify-between p-5 sm:p-6 md:col-span-5"
        data-reveal
      >
        <div>
          <div
            class="flex items-center gap-2 text-[11px] font-semibold tracking-[0.14em]"
            style="color: var(--lp-pink-dark)"
          >
            <Icon name="tabler:arrows-minimize" class="h-4 w-4" /> 贴边收起
          </div>
          <h3 class="lp-card-title mt-2">靠近就出</h3>
        </div>

        <div class="bento-demo-surface relative mt-6 h-40 overflow-hidden rounded-2xl">
          <div
            class="bento-dock-sheet absolute bottom-5 left-5 top-5 w-[46%] rounded-lg border p-2.5 shadow-lg"
            aria-hidden="true"
          >
            <div class="flex gap-1">
              <span class="bento-dock-line h-1.5 w-1.5 rounded-full"></span>
              <span class="bento-dock-line h-1.5 w-1.5 rounded-full"></span>
              <span class="bento-dock-line h-1.5 w-1.5 rounded-full"></span>
            </div>
            <div class="mt-3 space-y-1.5">
              <div class="bento-dock-line h-1.5 w-5/6 rounded-full"></div>
              <div class="bento-dock-line h-1.5 w-2/3 rounded-full"></div>
              <div class="bento-dock-line h-1.5 w-3/4 rounded-full"></div>
            </div>
          </div>

          <div class="lp-edge absolute inset-y-0 right-[16%] w-px"></div>
          <div class="bento-dock-handle absolute right-[16%] top-1/2 w-2 -translate-y-1/2 overflow-hidden rounded-l">
            <ProductPreview kind="dock" alt="弹幕窗贴边收起后显示的窄条" />
          </div>
          <div
            class="bento-dock-pointer absolute right-[8%] top-1/2 grid h-7 w-7 -translate-y-1/2 place-items-center rounded-full shadow-lg"
            aria-hidden="true"
          >
            <Icon name="tabler:pointer" class="h-4 w-4" style="color: var(--lp-pink-dark)" />
          </div>
          <span class="absolute bottom-4 left-5 text-[10px] font-medium" style="color: var(--lp-muted)">
            移开 250ms 收起
          </span>
        </div>
      </article>

      <!-- 仅输入框 -->
      <article class="lp-bento-card intersect intersect-once p-5 sm:p-6 md:col-span-4" data-reveal>
        <div
          class="flex items-center gap-2 text-[11px] font-semibold tracking-[0.14em]"
          style="color: var(--lp-pink-dark)"
        >
          <Icon name="tabler:keyboard" class="h-4 w-4" /> 仅输入框
        </div>
        <h3 class="lp-card-title mt-2">一行就够</h3>

        <div class="bento-demo-surface mt-6 rounded-2xl p-3">
          <div class="bento-image-frame">
            <ProductPreview kind="input" alt="弹幕仅输入框模式，右侧按钮可以恢复完整窗口" />
          </div>
          <div class="mt-2 flex justify-between text-[10px]" style="color: var(--lp-muted)">
            <span>底边锚定</span><span>Enter ↵</span>
          </div>
        </div>
      </article>

      <!-- 听视频 -->
      <article class="lp-bento-card intersect intersect-once p-5 sm:p-6 md:col-span-4" data-reveal>
        <div
          class="flex items-center gap-2 text-[11px] font-semibold tracking-[0.14em]"
          style="color: var(--lp-pink-dark)"
        >
          <Icon name="tabler:headphones" class="h-4 w-4" /> 听视频
        </div>
        <h3 class="lp-card-title mt-2">不看也在听</h3>

        <div class="bento-demo-surface mt-6 rounded-2xl p-3">
          <div class="flex items-center gap-3">
            <img src={cover0.src} alt="" class="h-11 w-11 rounded-lg object-cover" />
            <div class="min-w-0 flex-1">
              <div class="truncate text-xs font-semibold">夜间电台 · 给自己一点空白</div>
              <div class="text-[10px]" style="color: var(--lp-muted)">给自己的片刻安静</div>
            </div>
          </div>
          <div class="bento-image-frame mt-3">
            <ProductPreview kind="audio" alt="视频音频播放器的进度、播放和音量控件" />
          </div>
        </div>
      </article>

      <!-- 外观 -->
      <article class="lp-bento-card intersect intersect-once overflow-hidden p-5 sm:p-6 md:col-span-4" data-reveal>
        <div
          class="flex items-center gap-2 text-[11px] font-semibold tracking-[0.14em]"
          style="color: var(--lp-pink-dark)"
        >
          <Icon name="tabler:palette" class="h-4 w-4" /> 外观
        </div>
        <h3 class="lp-card-title mt-2">自己调</h3>

        <div class="bento-settings-preview bento-image-frame mt-5">
          <ProductPreview kind="settings" alt="弹幕窗的外观设置，包含主题和背景透明度" />
        </div>
      </article>

      <!-- 视频弹幕窗 -->
      <article class="lp-bento-card intersect intersect-once p-5 sm:p-6 md:col-span-7" data-reveal>
        <div
          class="flex items-center gap-2 text-[11px] font-semibold tracking-[0.14em]"
          style="color: var(--lp-pink-dark)"
        >
          <Icon name="tabler:subtitles" class="h-4 w-4" /> 视频弹幕窗
        </div>
        <h3 class="lp-card-title mt-2">字幕和弹幕，一起走</h3>

        <div class="bento-demo-surface mt-5 rounded-2xl p-3">
          <div class="bento-video-preview bento-image-frame mx-auto">
            <ProductPreview kind="video" alt="视频弹幕窗，上方是字幕，下方是视频弹幕和播放进度" />
          </div>
        </div>
      </article>

      <!-- AI 接入 -->
      <article
        class="lp-bento-card is-pink intersect intersect-once flex flex-col justify-between p-5 sm:p-6 md:col-span-5"
        data-reveal
      >
        <div>
          <div class="flex items-center gap-2 text-[11px] font-semibold tracking-[0.14em] text-white/70">
            <Icon name="tabler:sparkles" class="h-4 w-4" /> AI 接入
          </div>
          <h3 class="lp-card-title mt-2 text-white">本地 MCP</h3>
          <p class="mt-2 text-xs leading-6 text-white/70">外部 AI 读懂直播间，token 只在本机。</p>
        </div>

        <div class="bento-image-frame mt-5 w-full max-w-[25.5rem] self-center">
          <ProductPreview kind="mcp" alt="BiliDanmu 的 MCP 配置窗口，显示服务状态、访问 token 和客户端配置" />
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .bento-demo-surface {
    background: color-mix(in srgb, var(--lp-soft) 70%, transparent);
  }

  .bento-image-frame {
    overflow: clip;
    border: 1px solid var(--lp-line);
    border-radius: 0.75rem;
  }

  .bento-live-activity {
    position: relative;
    aspect-ratio: 4 / 1;
  }

  .bento-live-activity :global(picture) {
    position: absolute;
    inset: 0;
  }

  .bento-live-activity :global(img) {
    translate: 0 -12%;
  }

  .bento-dock-sheet,
  .bento-dock-pointer {
    border-color: var(--lp-line);
    background: var(--lp-card);
  }

  .bento-dock-line {
    background: var(--lp-line);
  }

  .bento-dock-handle {
    box-shadow: 0 0 1rem color-mix(in srgb, var(--lp-pink) 38%, transparent);
  }

  .bento-settings-preview {
    max-height: 10rem;
  }

  .bento-video-preview {
    max-width: 22rem;
  }
</style>
