---
import { Icon } from 'astro-icon/components';
import ProductPreview from './ProductPreview.astro';

const REPOSITORY = 'https://github.com/sfqy211/bilidanmu';
const RELEASES = `${REPOSITORY}/releases/latest`;
---

<section class="lp-hero-wrap">
  <div class="lp-hero-panel lp-noise">
    <div class="lp-hero-grid"></div>
    <div class="lp-glow lp-glow-pink absolute -right-24 top-0 h-[26rem] w-[26rem]"></div>
    <div class="lp-glow lp-glow-blue absolute -left-28 bottom-0 h-[22rem] w-[22rem]"></div>

    <div
      class="relative z-10 mx-auto grid max-w-7xl items-center gap-12 px-5 py-14 sm:px-8 lg:grid-cols-[0.92fr_1.08fr] lg:gap-10 lg:py-20"
    >
      <div class="intersect intersect-once max-w-xl" data-reveal="hero">
        <span class="lp-badge">
          <span class="lp-live-dot"></span>
          B 站桌面弹幕伴侣
        </span>

        <h1 class="mt-6 font-heading text-[clamp(2.9rem,6.2vw,5.4rem)] font-black leading-[1.02] tracking-[-0.045em]">
          桌面归你，<br />
          <span class="lp-gradient-text">热闹在旁。</span>
        </h1>

        <p class="lp-panel-muted mt-5 text-lg leading-8">B 站直播，收进桌面一角。</p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a class="lp-btn-primary" href={RELEASES} target="_blank" rel="noopener noreferrer">
            <Icon name="tabler:download" class="h-4 w-4" />
            下载 BiliDanmu
          </a>
          <button type="button" class="lp-btn-ghost" data-open-film aria-haspopup="dialog" aria-controls="film-dialog">
            <span class="lp-panel-icon grid h-5 w-5 place-items-center rounded-full">
              <Icon name="tabler:player-play-filled" class="h-3 w-3" />
            </span>
            45 秒演示
          </button>
        </div>

        <div class="lp-panel-subtle mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs">
          <span class="inline-flex items-center gap-1.5">
            <Icon name="tabler:brand-windows" class="h-4 w-4" /> Windows
          </span>
          <span class="inline-flex items-center gap-1.5">
            <Icon name="tabler:brand-apple" class="h-4 w-4" /> macOS
          </span>
          <span class="inline-flex items-center gap-1.5">
            <Icon name="tabler:brand-ubuntu" class="h-4 w-4" /> Linux
          </span>
        </div>
      </div>

      <figure class="hero-stage intersect intersect-once" data-reveal="hero">
        <div class="lp-glow lp-glow-pink absolute -inset-10 opacity-70"></div>
        <ProductPreview kind="workspace" class="hero-workspace" alt="BiliDanmu 主窗口中的直播间列表" loading="eager" />
        <ProductPreview kind="liveGlass" class="hero-danmaku" alt="叠在主窗口右侧的半透明直播弹幕窗" loading="eager" />
      </figure>
    </div>
  </div>
</section>

<style>
  .hero-stage {
    position: relative;
    inline-size: 100%;
    max-inline-size: 35rem;
    aspect-ratio: 1.27;
    margin: 0 auto;
  }

  .hero-stage :global(.hero-workspace),
  .hero-stage :global(.hero-danmaku) {
    position: absolute;
    overflow: clip;
    border: 1px solid var(--lp-panel-line);
    border-radius: clamp(0.5rem, 1.1vw, 0.875rem);
    box-shadow: var(--lp-window-shadow);
  }

  .hero-stage :global(.hero-workspace) {
    inset-block-start: 7%;
    inset-inline-start: 1%;
    inline-size: 92%;
  }

  .hero-stage :global(.hero-danmaku) {
    inset-block-end: 4%;
    inset-inline-end: 0;
    inline-size: 52%;
    max-inline-size: 16rem;
  }

  @media (min-width: 40rem) {
    .hero-stage :global(.hero-danmaku) {
      inline-size: 46%;
    }
  }
</style>
