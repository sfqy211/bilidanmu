---
import { Icon } from 'astro-icon/components';

const scenes = [
  {
    title: '写代码时',
    copy: '弹幕在边缘，编辑器是整块。',
    gradient: 'radial-gradient(120% 120% at 82% 18%, #7db6d4 0%, #2c5874 48%, #0d1720 100%)',
    icon: 'tabler:code',
  },
  {
    title: '看文档时',
    copy: '只留一行输入框。',
    gradient: 'radial-gradient(120% 120% at 82% 18%, #e2a49c 0%, #8c5362 48%, #1e1117 100%)',
    icon: 'tabler:book',
  },
  {
    title: '睡前听视频',
    copy: '关掉屏幕，声音还在。',
    gradient: 'radial-gradient(120% 120% at 82% 18%, #a7cfc4 0%, #2f6b60 48%, #0c1a17 100%)',
    icon: 'tabler:moon',
  },
];
---

<section id="scenes" class="lp-section scroll-mt-24 py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="lp-eyebrow">使用场景</p>
        <h2 class="lp-h2 mt-3">它适合这些时刻。</h2>
      </div>
      <p class="lp-lead max-w-md sm:text-right">刚好在，不打扰。</p>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      {
        scenes.map((scene) => (
          <article class="lp-scene group min-h-[18rem] p-5" style={`background: ${scene.gradient}`}>
            <div class="relative flex h-full flex-col justify-end">
              <span class="grid h-10 w-10 place-items-center rounded-full border border-white/20 bg-white/10 backdrop-blur">
                <Icon name={scene.icon} class="h-5 w-5 text-white" />
              </span>
              <h3 class="mt-4 text-xl font-bold tracking-tight text-white">{scene.title}</h3>
              <p class="mt-1.5 max-w-xs text-sm leading-6 text-white/70">{scene.copy}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
