---
import { Icon } from 'astro-icon/components';

const VERSION = '0.5.5';
const REPOSITORY = 'https://github.com/sfqy211/bilidanmu';
const ASSETS = `${REPOSITORY}/releases/download/app-v${VERSION}`;
const RELEASES = `${REPOSITORY}/releases`;

const platforms = [
  {
    name: 'Windows',
    detail: '10 / 11 · x64',
    file: `BiliDanmu_${VERSION}_x64-setup.exe`,
    icon: 'tabler:brand-windows',
    hint: '.exe 安装包',
  },
  {
    name: 'macOS',
    detail: 'Intel / Apple Silicon',
    file: `BiliDanmu_${VERSION}_universal.dmg`,
    icon: 'tabler:brand-apple',
    hint: '.dmg · 首次打开右键',
    preview: true,
  },
  {
    name: 'Linux',
    detail: 'x64 · AppImage',
    file: `BiliDanmu_${VERSION}_amd64.AppImage`,
    icon: 'tabler:brand-ubuntu',
    hint: '.AppImage',
    preview: true,
  },
];
---

<section id="download" class="lp-section scroll-mt-24 py-6 sm:py-10">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="lp-panel relative overflow-clip rounded-[2rem] p-6 sm:p-10 lg:p-14">
      <div class="lp-glow lp-glow-pink absolute -right-20 -top-24 h-80 w-80"></div>
      <div class="lp-glow lp-glow-blue absolute -bottom-28 left-16 h-72 w-72"></div>

      <div class="relative grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-center lg:gap-16">
        <div class="intersect intersect-once" data-reveal>
          <span class="lp-badge">BILIDANMU V{VERSION}</span>
          <h2 class="mt-5 text-4xl font-black leading-[1.04] tracking-[-0.04em] sm:text-5xl">
            给喜欢的直播，<br />
            <span class="lp-gradient-text">留个位置。</span>
          </h2>
          <p class="lp-panel-muted mt-4 max-w-md text-sm leading-7">Windows · macOS · Linux。免费开源。</p>
          <div class="lp-panel-subtle mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-[11px]">
            <span class="inline-flex items-center gap-1.5">
              <Icon name="tabler:shield-check" class="h-4 w-4" /> 本地运行
            </span>
            <span class="inline-flex items-center gap-1.5">
              <Icon name="tabler:license" class="h-4 w-4" /> AGPL-3.0
            </span>
          </div>
        </div>

        <div class="intersect intersect-once grid gap-3" data-reveal>
          <p id="preview-download-note" class="lp-panel-muted text-xs leading-5">
            macOS 和 Linux 为预览版，尚未经过测试。
          </p>
          {
            platforms.map((platform) => (
              <a
                href={`${ASSETS}/${platform.file}`}
                target="_blank"
                rel="noopener noreferrer"
                aria-describedby={platform.preview ? 'preview-download-note' : undefined}
                class="lp-panel-action group flex items-center gap-4 rounded-2xl border p-4"
              >
                <span class="lp-panel-icon grid h-11 w-11 shrink-0 place-items-center rounded-xl">
                  <Icon name={platform.icon} class="h-5 w-5" />
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block text-sm font-semibold">{platform.name}</span>
                  <span class="lp-panel-muted text-xs">{platform.detail}</span>
                </span>
                <span class="lp-panel-subtle hidden shrink-0 text-[11px] sm:block">{platform.hint}</span>
                <Icon name="tabler:download" class="lp-panel-accent h-4 w-4 shrink-0" />
              </a>
            ))
          }
          <div class="lp-panel-subtle mt-1 flex items-center justify-between text-[11px]">
            <a class="lp-panel-link" href={RELEASES} target="_blank" rel="noopener noreferrer"> 全部版本与更新记录 </a>
            <a class="lp-panel-link" href="./docs/guide/quick-start/"> 安装说明 </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
