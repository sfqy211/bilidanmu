# ─────────────────────────────────────────────────────────────
# 行尾统一为 LF
#
# 背景：Windows 上 Git 安装时默认 core.autocrlf=true，
# 工作区会被转成 CRLF。本机已把系统级改为 false，但仓库里
# 必须有显式声明，否则换台机器 clone 又会踩同一个坑。
#
# 本项目含 Tauri(Rust) + React(TS) + GitHub Actions，
# 其中 .sh / workflow 里的脚本一旦带 \r 会直接执行失败。
# ─────────────────────────────────────────────────────────────

# 兜底：所有文件按文本处理，统一 LF
* text=auto eol=lf

# ── 文本文件 ────────────────────────────────────────────────
*.rs         text eol=lf
*.toml       text eol=lf
*.ts         text eol=lf
*.tsx        text eol=lf
*.js         text eol=lf
*.mjs        text eol=lf
*.cjs        text eol=lf
*.json       text eol=lf
*.css        text eol=lf
*.scss       text eol=lf
*.html       text eol=lf
*.md         text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.sh         text eol=lf
*.sql        text eol=lf
*.xml        text eol=lf
Dockerfile   text eol=lf
*.conf       text eol=lf
.env*        text eol=lf
.gitignore   text eol=lf
.gitattributes text eol=lf

# ── 二进制：禁止任何转换 ────────────────────────────────────
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.ico      binary
*.icns     binary
*.mp4      binary
*.webm     binary
*.mov      binary
*.pdf      binary
*.zip      binary
*.gz       binary
*.tar      binary
*.db       binary
*.db-wal   binary
*.db-shm   binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.otf      binary

# ── 运行时/构建产物 ─────────────────────────────────────────
node_modules/**  -text
dist/**          -text
src-tauri/target/** -text
